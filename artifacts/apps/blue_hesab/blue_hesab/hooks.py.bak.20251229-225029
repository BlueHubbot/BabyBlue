# -*- coding: utf-8 -*-
"""
BlueHesab - Frappe hooks

این فایل «تنها منبع حقیقت» برای hook های BlueHesab است.
هدف: جلوگیری از دوباره‌اجرا شدن منطق‌ها، حذف تداخل‌ها، و داشتن یک مسیر واضح برای VAT + خروجی‌های قانونی.

اصول:
- VAT Intent/Mode فقط در before_validate (vat_pos_intent + vat_pipeline)
- محاسبات VAT فقط در validate (vat_pipeline)
- خروجی قانونی VAT فقط در on_submit و on_cancel (legal_hooks)
- هیچ handler موازی/قدیمی (مثل vat_legal_output.*) نباید در doc_events باشد.
"""

# apps/blue_hesab/blue_hesab/hooks.py
# BlueHesab - Frappe hooks (Single Source of Truth)

app_name = "blue_hesab"
app_title = "BlueHesab"
app_publisher = "BlueAPi"
app_description = "BlueHesab Core"
app_email = "dev@blueapi"
app_license = "MIT"

# -----------------------------------------------------------------------------
# VAT pipeline (single source of truth)
#
# Rule:
# - Intent / mode enforcement ONLY in before_validate (vat_pipeline)
# - Tax calculation ONLY in validate (vat_pipeline validates -> vat_hooks inside)
#
# Why:
# - Prevent double-running intent logic, keep draft behavior stable.
# -----------------------------------------------------------------------------

doc_events = {
    "Sales Invoice": {
        # POS intent + VAT intent/mode enforcement
        "before_validate": [
            "blue_hesab.bh_core.vat_pos_intent.bh_before_validate_sales_invoice_pos_intent",
            "blue_hesab.bh_core.vat_pipeline.bh_before_validate_sales_invoice",
        ],
        # VAT calculation + enforcement (must be idempotent)
        "validate": [
            "blue_hesab.bh_core.vat_pipeline.bh_validate_sales_invoice",
        ],
        # Legal outputs are compliance artifacts -> must be generated on submit
        # Dimensions must be applied before GL is posted.
        "on_submit": [
            "blue_hesab.bh_core.legal_hooks.on_submit_sales_invoice",
            "blue_hesab.bh_core.dimensions_hook_adapter.apply_gl_dimensions_from_invoice",
        ],
        # Cancel must be guarded + legal CANCEL output must be emitted here
        # (this is where your LEGAL-05 smoke already proves it works)
        "before_cancel": [
            "blue_hesab.bh_core.legal_cancel.bh_before_cancel_invoice",
            "blue_hesab.bh_core.legal_hooks.before_cancel_sales_invoice",
        ],
    },

    "Purchase Invoice": {
        "before_validate": [
            "blue_hesab.bh_core.vat_pipeline.bh_before_validate_purchase_invoice",
        ],
        "validate": [
            "blue_hesab.bh_core.vat_pipeline.bh_validate_purchase_invoice",
        ],
        "on_submit": [
            "blue_hesab.bh_core.legal_hooks.on_submit_purchase_invoice",
            "blue_hesab.bh_core.dimensions_hook_adapter.apply_gl_dimensions_from_invoice",
        ],
        "before_cancel": [
            "blue_hesab.bh_core.legal_cancel.bh_before_cancel_invoice",
            "blue_hesab.bh_core.legal_hooks.before_cancel_purchase_invoice",
        ],
    },

    # -----------------------------------------------------------------------------
    # BH Legal Output immutability (NNG-02)
    #
    # Compliance artifacts must be immutable after submit.
    # -----------------------------------------------------------------------------
    "BH Legal Output": {
        "on_update_after_submit": "blue_hesab.bh_core.legal_immutability.on_update_after_submit",
        "on_cancel": "blue_hesab.bh_core.legal_immutability.on_cancel",
        "on_trash": "blue_hesab.bh_core.legal_immutability.on_trash",
    },
}

# -----------------------------------------------------------------------------
# VAT-19 UI Guard
# Force-load on Desk; doctype_js sometimes misses due to meta caching
# -----------------------------------------------------------------------------
app_include_js = [
    "/assets/blue_hesab/js/vat_guard_ui.js?v=2470",
]

# Optional (harmless) doctype injection too
doctype_js = {
    "Sales Invoice": "public/js/vat_guard_ui.js?v=2470",
    "Purchase Invoice": "public/js/vat_guard_ui.js?v=2470",
}
