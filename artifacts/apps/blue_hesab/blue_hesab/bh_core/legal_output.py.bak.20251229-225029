# apps/blue_hesab/blue_hesab/bh_core/legal_output.py
# -*- coding: utf-8 -*-
"""
BH Legal Output — generator + hashing + persistence

هدف:
- ساخت یک رکورد غیرقابل‌تغییر (immutable) برای خروجی‌های قانونی
- ثبت schema_version + generator_build + hashes برای audit/repro
- enforce chain/idempotency با legal_policy.enforce_legal_output_chain
"""

from __future__ import annotations

from typing import Any
import hashlib
import json

import frappe


def _json_default(obj: Any) -> Any:
    # Stable JSON for hashing (dates -> isoformat)
    try:
        import datetime as _dt
        if isinstance(obj, (_dt.date, _dt.datetime)):
            return obj.isoformat()
    except Exception:
        pass
    return str(obj)


def _stable_json(obj: Any) -> str:
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"), default=_json_default)


def _sha256_hex(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def _default_schema_version() -> str:
    # Prefer VERSION file if present; fallback BH-DEV.
    # You can later wire this to your GitOps tag / schema_version.
    try:
        # blue_hesab/VERSION typically exists in your workflow
        from pathlib import Path
        p = Path(__file__).resolve().parents[1] / "VERSION"
        if p.exists():
            v = p.read_text(encoding="utf-8").strip()
            if v:
                return v
    except Exception:
        pass
    return "BH-DEV"


def _normalize_reason(v: str | None) -> str | None:
    if not v:
        return None
    v = str(v).strip().upper()
    return v or None


def create_legal_output(
    *,
    company: str,
    output_type: str,
    reference_doctype: str,
    reference_name: str,

    # chain
    correction_reason: str | None = None,
    previous_output: str | None = None,

    # versioning
    schema_version: str | None = None,
    generator_build: str | None = None,

    # auditable payloads (compat: optional)
    source: dict | None = None,
    payload: dict | None = None,

    # hashes (optional override)
    source_hash: str | None = None,
    payload_hash: str | None = None,

    # compat: some callers used event=... (or other kwargs) in older iterations
    event: str | None = None,

    # compat: swallow any legacy kwargs without crashing production
    **_compat: Any,
) -> str:
    """
    Create and SUBMIT a BH Legal Output document.

    Compatibility guarantees:
    - source/payload are OPTIONAL (we will default to minimal dicts)
    - accepts event=... and unknown legacy kwargs (ignored)
    - computes hashes deterministically
    """

    correction_reason = _normalize_reason(correction_reason)

    if not schema_version:
        schema_version = _default_schema_version()
    if not generator_build:
        generator_build = schema_version

    # Minimal source/payload if caller didn't provide
    source = dict(source or {})
    payload = dict(payload or {})

    if event and "event" not in source:
        source["event"] = event

    # Always embed reference + chain in source (so hashes remain meaningful)
    source.setdefault("company", company)
    source.setdefault("output_type", output_type)
    source.setdefault("reference_doctype", reference_doctype)
    source.setdefault("reference_name", reference_name)
    source.setdefault("correction_reason", correction_reason)
    source.setdefault("previous_output", previous_output)

    # Default payload can stay minimal; caller may pass full structured payload
    payload.setdefault("output_type", output_type)
    payload.setdefault("correction_reason", correction_reason)
    payload.setdefault("previous_output", previous_output)

    # Hashes
    src_json = _stable_json(source)
    pay_json = _stable_json(payload)

    if not source_hash:
        source_hash = _sha256_hex(src_json)
    if not payload_hash:
        payload_hash = _sha256_hex(pay_json)

    # Create document
    doc = frappe.new_doc("BH Legal Output")
    doc.company = company
    doc.output_type = output_type
    doc.reference_doctype = reference_doctype
    doc.reference_name = reference_name
    doc.correction_reason = correction_reason
    doc.schema_version = schema_version
    doc.generator_build = generator_build

    # These fields must exist on the DocType
    doc.source_hash = source_hash
    doc.payload_hash = payload_hash
    doc.source_json = json.dumps(source, ensure_ascii=False, indent=2, sort_keys=True, default=_json_default)
    doc.payload_json = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True, default=_json_default)

    if previous_output:
        doc.previous_output = previous_output

    # metadata
    user = frappe.session.user if getattr(frappe, "session", None) else "Administrator"
    doc.generated_by = user
    doc.generated_at = frappe.utils.now()

    # Insert + submit (immutability hooks will guard later edits)
    doc.insert(ignore_permissions=True)
    doc.submit()

    return doc.name