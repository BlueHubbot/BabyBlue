from __future__ import annotations

from typing import Any, Dict, List, Optional, Tuple

import frappe
from frappe.exceptions import ValidationError

from .vat_pipe_common import (
    KIND_PURCHASE,
    KIND_SALES,
    MODE_EXCL,
    MODE_INCL,
    infer_mixed_template_name,
)

CUSTOMER_NAME = "مشتری تست VAT"
SUPPLIER_NAME = "BH VAT REG Supplier"
ITEM_CODE = "BH-VAT-STD_9-TEST"


def _has_field(doc, fieldname: str) -> bool:
    try:
        return bool(doc.meta and doc.meta.has_field(fieldname))
    except Exception:
        return False


def _pick_any(doctype: str, *, name_field: str = "name") -> Optional[str]:
    try:
        rows = frappe.get_all(doctype, fields=[name_field], limit=1)
        if rows:
            return rows[0].get(name_field)
    except Exception:
        return None
    return None


def _pick_leaf_account(company: str, root_type: str) -> str:
    rows = frappe.get_all(
        "Account",
        filters={"company": company, "is_group": 0, "root_type": root_type, "disabled": 0},
        fields=["name"],
        limit=1,
    )
    if not rows:
        rows = frappe.get_all(
            "Account",
            filters={"company": company, "is_group": 0, "disabled": 0},
            fields=["name"],
            limit=1,
        )
    if not rows:
        raise ValidationError(f"VAT-12: no leaf Account found for company={company}")
    return rows[0]["name"]


def _ensure_customer(company: str) -> str:
    if frappe.db.exists("Customer", CUSTOMER_NAME):
        return CUSTOMER_NAME
    doc = frappe.get_doc(
        {
            "doctype": "Customer",
            "customer_name": CUSTOMER_NAME,
            "customer_type": "Individual",
            "customer_group": "All Customer Groups",
            "territory": "All Territories",
        }
    )
    doc.insert(ignore_permissions=True)
    return doc.name


def _ensure_supplier(company: str) -> str:
    if frappe.db.exists("Supplier", SUPPLIER_NAME):
        return SUPPLIER_NAME
    doc = frappe.get_doc(
        {
            "doctype": "Supplier",
            "supplier_name": SUPPLIER_NAME,
            "supplier_type": "Company",
            "supplier_group": "All Supplier Groups",
        }
    )
    doc.insert(ignore_permissions=True)
    return doc.name


def _ensure_item(company: str) -> str:
    if frappe.db.exists("Item", ITEM_CODE):
        return ITEM_CODE

    uom = _pick_any("UOM") or "Nos"
    item_group = "All Item Groups"
    if not frappe.db.exists("Item Group", item_group):
        item_group = _pick_any("Item Group") or item_group

    income = _pick_leaf_account(company, "Income")
    expense = _pick_leaf_account(company, "Expense")

    doc = frappe.get_doc(
        {
            "doctype": "Item",
            "item_code": ITEM_CODE,
            "item_name": ITEM_CODE,
            "item_group": item_group,
            "stock_uom": uom,
            "is_stock_item": 0,
            "is_sales_item": 1,
            "is_purchase_item": 1,
            "item_defaults": [
                {"company": company, "income_account": income, "expense_account": expense}
            ],
        }
    )
    doc.insert(ignore_permissions=True)
    return doc.name


def _set_if_has(doc, fieldname: str, value) -> None:
    try:
        if _has_field(doc, fieldname):
            doc.set(fieldname, value)
    except Exception:
        pass


def _pick_cash_or_bank_account(company: str) -> str | None:
    rows = frappe.get_all(
        "Account",
        filters={
            "company": company,
            "is_group": 0,
            "account_type": ["in", ["Cash", "Bank"]],
            "disabled": 0,
        },
        fields=["name", "account_type"],
        order_by="account_type desc, name asc",
        limit=1,
    )
    if rows:
        return rows[0]["name"]

    # last resort fallback (should almost never happen)
    rows = frappe.get_all(
        "Account",
        filters={"company": company, "is_group": 0, "disabled": 0},
        fields=["name"],
        order_by="modified desc",
        limit=1,
    )
    return rows[0]["name"] if rows else None


def _pick_pos_mop_account(company: str) -> tuple[str, str]:
    """
    Return (mode_of_payment, default_account) guaranteed to be usable for POS submit.

    - Prefer any existing Mode of Payment that already has a Mode of Payment Account
      row with default_account set for this company.
    - If a row exists but default_account is empty → repair it.
    - If nothing exists → create a deterministic MOP ("BH POS") and attach a Cash/Bank account.
    """
    # Prefer any existing MOP account row with default_account set
    rows = frappe.get_all(
        "Mode of Payment Account",
        filters={"company": company},
        fields=["parent", "default_account"],
        order_by="modified desc",
    )
    for r in rows:
        if r.get("default_account"):
            return r["parent"], r["default_account"]

    acc = _pick_cash_or_bank_account(company)
    if not acc:
        raise RuntimeError(f"BH VAT INTENT: no Cash/Bank account found for company={company}")

    # If there is an MOP row but missing default_account → repair it
    if rows:
        mop = rows[0]["parent"]
        frappe.db.set_value(
            "Mode of Payment Account",
            {"parent": mop, "company": company},
            "default_account",
            acc,
        )
        return mop, acc

    # Otherwise create a dedicated MOP (safe + deterministic)
    mop_name = "BH POS"
    if not frappe.db.exists("Mode of Payment", mop_name):
        frappe.get_doc(
            {"doctype": "Mode of Payment", "mode_of_payment": mop_name, "type": "Cash"}
        ).insert(ignore_permissions=True)

    mop = frappe.get_doc("Mode of Payment", mop_name)
    if not frappe.db.exists("Mode of Payment Account", {"parent": mop_name, "company": company}):
        mop.append("accounts", {"company": company, "default_account": acc})
        mop.save(ignore_permissions=True)
    else:
        frappe.db.set_value(
            "Mode of Payment Account",
            {"parent": mop_name, "company": company},
            "default_account",
            acc,
        )

    return mop_name, acc


def _apply_pos_payment(doc, company: str, *, fallback_amount: float) -> None:
    if not _has_field(doc, "payments"):
        return

    mop, acc = _pick_pos_mop_account(company)

    # try to ensure totals are present before picking amount
    try:
        if hasattr(doc, "set_missing_values"):
            doc.set_missing_values()
        if hasattr(doc, "calculate_taxes_and_totals"):
            doc.calculate_taxes_and_totals()
    except Exception:
        pass

    amt = float(
        getattr(doc, "rounded_total", 0)
        or getattr(doc, "grand_total", 0)
        or getattr(doc, "net_total", 0)
        or fallback_amount
        or 0
    )

    doc.set("payments", [])
    # ERPNext v15: Sales Invoice Payment usually has both mode_of_payment and account
    doc.append("payments", {"mode_of_payment": mop, "account": acc, "amount": amt})
    _set_if_has(doc, "paid_amount", amt)
    _set_if_has(doc, "base_paid_amount", amt)


def _mk_sales_invoice(
    *,
    company: str,
    customer: str,
    rate: float,
    taxes_and_charges: str,
    price_mode: Optional[str],
    is_pos: bool,
) -> Any:
    item_code = _ensure_item(company)
    income = _pick_leaf_account(company, "Income")

    si = frappe.get_doc(
        {
            "doctype": "Sales Invoice",
            "company": company,
            "customer": customer,
            "items": [{"item_code": item_code, "qty": 1, "rate": rate, "income_account": income}],
            "taxes_and_charges": taxes_and_charges,
        }
    )

    if price_mode:
        _set_if_has(si, "bh_vat_price_mode", price_mode)
        _set_if_has(si, "bh_vat_inclusive_intent", 1 if price_mode == MODE_INCL else 0)

    if is_pos:
        _set_if_has(si, "is_pos", 1)
        pos_profile = _pick_any("POS Profile")
        if pos_profile:
            _set_if_has(si, "pos_profile", pos_profile)

    si.insert(ignore_permissions=True)

    # POS hardening: ensure a valid MOP + default_account exists and payment covers grand_total
    if is_pos:
        try:
            si.reload()
            _apply_pos_payment(si, company, fallback_amount=rate)
            si.save(ignore_permissions=True)
            si.reload()
        except Exception:
            # keep the doc; submit attempt will surface real failure reason in test output
            pass

    return si


def _mk_purchase_invoice(
    *,
    company: str,
    supplier: str,
    rate: float,
    taxes_and_charges: str,
    price_mode: Optional[str],
) -> Any:
    item_code = _ensure_item(company)
    expense = _pick_leaf_account(company, "Expense")

    pi = frappe.get_doc(
        {
            "doctype": "Purchase Invoice",
            "company": company,
            "supplier": supplier,
            "items": [{"item_code": item_code, "qty": 1, "rate": rate, "expense_account": expense}],
            "taxes_and_charges": taxes_and_charges,
        }
    )

    if price_mode:
        _set_if_has(pi, "bh_vat_price_mode", price_mode)
        _set_if_has(pi, "bh_vat_inclusive_intent", 1 if price_mode == MODE_INCL else 0)

    pi.insert(ignore_permissions=True)
    return pi


def _try_submit(doc) -> Tuple[bool, str]:
    try:
        doc.submit()
        return True, ""
    except Exception as e:
        return False, str(e)


def _cleanup(docs: List[Tuple[str, str]]) -> None:
    for dt, name in reversed(docs):
        try:
            d = frappe.get_doc(dt, name)
        except Exception:
            continue
        try:
            if getattr(d, "docstatus", 0) == 1:
                try:
                    d.cancel()
                except Exception:
                    pass
            d.delete(ignore_permissions=True)
        except Exception:
            pass


def intent_regress_v08(*, company: str = "BlueAPi", rate: float = 1_000_000) -> Dict[str, Any]:
    created: List[Tuple[str, str]] = []
    cases: List[Dict[str, Any]] = []

    customer = _ensure_customer(company)
    supplier = _ensure_supplier(company)

    tpl_sales_excl = infer_mixed_template_name(kind=KIND_SALES, company=company, mode=MODE_EXCL)
    tpl_sales_incl = infer_mixed_template_name(kind=KIND_SALES, company=company, mode=MODE_INCL)
    tpl_purchase_excl = infer_mixed_template_name(kind=KIND_PURCHASE, company=company, mode=MODE_EXCL)
    tpl_purchase_incl = infer_mixed_template_name(kind=KIND_PURCHASE, company=company, mode=MODE_INCL)

    passed = 0
    failed = 0

    def _add_case(row: Dict[str, Any]) -> None:
        nonlocal passed, failed
        cases.append(row)
        if row.get("pass"):
            passed += 1
        else:
            failed += 1

    # CASE 1: nonPOS missing-mode + INCL template => default EXCL + submit-block
    try:
        si = _mk_sales_invoice(
            company=company,
            customer=customer,
            rate=rate,
            taxes_and_charges=tpl_sales_incl,
            price_mode=None,
            is_pos=False,
        )
        created.append(("Sales Invoice", si.name))
        si.reload()
        defaulted_to = (si.get("bh_vat_price_mode") or None)
        ok_submit, reason = _try_submit(si)
        _add_case(
            {
                "sid": "INT08-SI-01",
                "id": "INT08-SI-01 nonPOS missing-mode INCL->default EXCL + submit-block",
                "pass": (defaulted_to == MODE_EXCL and not ok_submit),
                "defaulted_to": defaulted_to,
                "mismatch": True,
                "suggested": tpl_sales_excl,
                "submit_blocked": (not ok_submit),
                "reason": reason if (not ok_submit) else "",
                "ok": True,
            }
        )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-SI-01",
                "id": "INT08-SI-01 nonPOS missing-mode INCL->default EXCL + submit-block",
                "pass": False,
                "reason": str(e),
                "ok": False,
            }
        )

    # CASE 2: nonPOS explicit INCL + EXCL tpl => submit-block
    try:
        si = _mk_sales_invoice(
            company=company,
            customer=customer,
            rate=rate,
            taxes_and_charges=tpl_sales_excl,
            price_mode=MODE_INCL,
            is_pos=False,
        )
        created.append(("Sales Invoice", si.name))
        ok_submit, reason = _try_submit(si)
        _add_case(
            {
                "sid": "INT08-SI-02",
                "id": "INT08-SI-02 nonPOS explicit INCL + EXCL tpl => submit-block",
                "pass": (not ok_submit),
                "submit_blocked": (not ok_submit),
                "reason": reason if (not ok_submit) else "",
                "ok": True,
            }
        )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-SI-02",
                "id": "INT08-SI-02 nonPOS explicit INCL + EXCL tpl => submit-block",
                "pass": False,
                "reason": str(e),
                "ok": False,
            }
        )

    # CASE 3: POS missing-mode + INCL template => implicit INCL + no block (submit OK)
    try:
        si = _mk_sales_invoice(
            company=company,
            customer=customer,
            rate=rate,
            taxes_and_charges=tpl_sales_incl,
            price_mode=None,
            is_pos=True,
        )
        created.append(("Sales Invoice", si.name))
        si.reload()
        defaulted_to = (si.get("bh_vat_price_mode") or None)
        ok_submit, reason = _try_submit(si)
        _add_case(
            {
                "sid": "INT08-SI-03",
                "id": "INT08-SI-03 POS missing-mode INCL => implicit INCL + no block",
                "pass": (defaulted_to == MODE_INCL and ok_submit),
                "defaulted_to": defaulted_to,
                "submit_blocked": (not ok_submit),
                "reason": reason if (not ok_submit) else "",
                "ok": True,
            }
        )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-SI-03",
                "id": "INT08-SI-03 POS missing-mode INCL => implicit INCL + no block",
                "pass": False,
                "reason": str(e),
                "ok": False,
            }
        )

    # CASE 4: purchase missing-mode + INCL template => default EXCL + submit-block
    try:
        pi = _mk_purchase_invoice(
            company=company,
            supplier=supplier,
            rate=rate,
            taxes_and_charges=tpl_purchase_incl,
            price_mode=None,
        )
        created.append(("Purchase Invoice", pi.name))
        pi.reload()
        defaulted_to = (pi.get("bh_vat_price_mode") or None)
        ok_submit, reason = _try_submit(pi)
        _add_case(
            {
                "sid": "INT08-PI-01",
                "id": "INT08-PI-01 purchase missing-mode INCL->default EXCL + submit-block",
                "pass": (defaulted_to == MODE_EXCL and not ok_submit),
                "defaulted_to": defaulted_to,
                "suggested": tpl_purchase_excl,
                "submit_blocked": (not ok_submit),
                "reason": reason if (not ok_submit) else "",
                "ok": True,
            }
        )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-PI-01",
                "id": "INT08-PI-01 purchase missing-mode INCL->default EXCL + submit-block",
                "pass": False,
                "reason": str(e),
                "ok": False,
            }
        )

    # CASE 5 (NEW): POS missing-mode + EXCL template => implicit EXCL + no lock (submit OK)
    try:
        si = _mk_sales_invoice(
            company=company,
            customer=customer,
            rate=rate,
            taxes_and_charges=tpl_sales_excl,
            price_mode=None,
            is_pos=True,
        )
        created.append(("Sales Invoice", si.name))
        si.reload()
        defaulted_to = (si.get("bh_vat_price_mode") or None)
        ok_submit, reason = _try_submit(si)
        _add_case(
            {
                "sid": "INT08-SI-05",
                "id": "INT08-SI-05 POS missing-mode EXCL => implicit EXCL + no block",
                "pass": (defaulted_to == MODE_EXCL and ok_submit),
                "defaulted_to": defaulted_to,
                "submit_blocked": (not ok_submit),
                "reason": reason if (not ok_submit) else "",
                "ok": True,
            }
        )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-SI-05",
                "id": "INT08-SI-05 POS missing-mode EXCL => implicit EXCL + no block",
                "pass": False,
                "reason": str(e),
                "ok": False,
            }
        )

    # CASE 6 (boundary): non-mixed template should be rejected upstream (no lock responsibility)
    try:
        non_mixed = "BH VAT (Sales) 0.0% - BA"
        if not frappe.db.exists("Sales Taxes and Charges Template", non_mixed):
            _add_case(
                {
                    "sid": "INT08-SI-04",
                    "id": "INT08-SI-04 boundary non-mixed template => skip (not found)",
                    "pass": True,
                    "skipped": True,
                    "ok": True,
                }
            )
        else:
            si = _mk_sales_invoice(
                company=company,
                customer=customer,
                rate=rate,
                taxes_and_charges=non_mixed,
                price_mode=None,
                is_pos=False,
            )
            created.append(("Sales Invoice", si.name))
            ok_submit, reason = _try_submit(si)
            _add_case(
                {
                    "sid": "INT08-SI-04",
                    "id": "INT08-SI-04 boundary non-mixed template => upstream reject / no lock",
                    "pass": True,
                    "skipped": True,
                    "submit_blocked": (not ok_submit),
                    "reason": reason,
                    "ok": True,
                }
            )
    except Exception as e:
        _add_case(
            {
                "sid": "INT08-SI-04",
                "id": "INT08-SI-04 boundary non-mixed template => upstream reject / no lock",
                "pass": True,
                "skipped": True,
                "submit_blocked": True,
                "reason": str(e),
                "ok": True,
            }
        )

    out = {"total": len(cases), "passed": passed, "failed": failed, "cases": cases, "created_docs": created}
    _cleanup(created)
    return out


def intent_regress_v08_cli(*, company: str = "BlueAPi") -> Dict[str, Any]:
    res = intent_regress_v08(company=company) or {}
    cases = res.get("cases") or []

    print("=== VAT-12 INTENT LOCK REGRESS v0.8 ===")
    passed = 0
    failed = 0
    for c in cases:
        cid = c.get("id") or c.get("sid") or "INT08-??"
        ok = bool(c.get("pass"))
        print(f"{cid}: {'PASS' if ok else 'FAIL'}")
        passed += 1 if ok else 0
        failed += 0 if ok else 1
    print(f"SUMMARY: total={len(cases)} passed={passed} failed={failed}")
    return res
