# --- JDate policy loader (CSV-based) ---

_POLICY_FILE = Path(__file__).resolve().parent / "config" / "jdate_policy_core_global.csv"


@lru_cache(maxsize=1)
def load_jdate_policy() -> list[dict[str, str]]:
    """بارگذاری ردیف‌های Policy JDate از CSV.

    خروجی:
        لیستی از dict با کلیدهای:
        domain_code,functional_area,object_type,object_name,
        output_type,audience,jdate_rule,blue_template_key,enabled
    """
    rows: list[dict[str, str]] = []

    try:
        path = _POLICY_FILE
        if not path.is_file():
            frappe.log_error(
                f"JDate policy file not found: {path}",
                "blue_jdate.load_jdate_policy",
            )
            return rows

        with path.open(mode="r", encoding="utf-8") as f:
            reader = csv.DictReader(f)
            for row in reader:
                clean_row = {
                    k: (v.strip() if isinstance(v, str) else "")
                    for k, v in row.items()
                }
                rows.append(clean_row)

    except Exception:
        frappe.log_error(
            title="blue_jdate.load_jdate_policy failed",
            message=frappe.get_traceback(),
        )
        return []

    return rows


# --- POLICY QUERY HELPERS ---

def find_jdate_policies(
    domain_code: str,
    object_type: str,
    object_name: str,
    output_type: str | None = None,
) -> list[dict[str, str]]:
    """برگشت همهٔ ردیف‌های Policy که با پارامترها match می‌شوند.

    Args:
        domain_code: مثل CORE_GLOBAL، MANUFACTURING_BASIC، RETAIL_POS و ...
        object_type: DocType / Report / PortalPage / ...
        object_name: نام DocType یا Report دقیقاً طبق ERPNext
        output_type: مثل DOC_PRINT / REPORT_PRINT / REPORT_EXPORT / POS_THERMAL / PORTAL_PAGE

    Returns:
        list[dict]: ردیف‌های فعال (enabled) که match هستند.
    """
    rows = load_jdate_policy()
    result: list[dict[str, str]] = []

    for row in rows:
        if row.get("domain_code") != domain_code:
            continue
        if row.get("object_type") != object_type:
            continue
        if row.get("object_name") != object_name:
            continue
        if output_type and row.get("output_type") != output_type:
            continue

        enabled = (row.get("enabled") or "").strip().lower()
        if enabled not in ("1", "true", "yes", "y"):
            continue

        result.append(row)

    return result


def get_jdate_rule(
    domain_code: str,
    object_type: str,
    object_name: str,
    output_type: str,
) -> Optional[str]:
    """برگشت اولین jdate_rule برای آبجکت موردنظر.

    اگر Policy پیدا نشود، None برمی‌گرداند.
    """
    matches = find_jdate_policies(
        domain_code=domain_code,
        object_type=object_type,
        object_name=object_name,
        output_type=output_type,
    )
    if not matches:
        return None

    rule = (matches[0].get("jdate_rule") or "").strip()
    return rule or None

