def export_print_formats_to_tmp():
    """Export all Print Format records HTML + meta to /tmp/blue_print_gallery/db."""
    import json
    from pathlib import Path
    import frappe

    base = Path("/tmp/blue_print_gallery/db")
    base.mkdir(parents=True, exist_ok=True)

    pfs = frappe.get_all(
        "Print Format",
        fields=["name", "doc_type", "module", "print_format_type", "custom_format", "disabled"],
        order_by="module asc, doc_type asc, name asc",
    )

    count = 0

    for pf in pfs:
        module = (pf.get("module") or "Core").replace(" ", "_")
        doctype = (pf.get("doc_type") or "Unknown").replace(" ", "_")
        name = pf["name"].replace(" ", "_")
        slug = f"{module}__{doctype}__{name}"

        meta_path = base / f"{slug}.meta.json"
        html_path = base / f"{slug}.html"

        doc = frappe.get_doc("Print Format", pf["name"])

        meta_path.write_text(json.dumps(pf, ensure_ascii=False, indent=2), encoding="utf-8")
        html_path.write_text(doc.html or "", encoding="utf-8")

        count += 1

    print("EXPORTED PF COUNT (from utils):", count)
    return count
